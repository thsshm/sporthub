# ════════════════════════════════════════════════════════════════════════
# SportHub V2 — Variables d'environnement local
# ════════════════════════════════════════════════════════════════════════
# Copier en .env.local et remplir. NE JAMAIS commit .env.local (déjà dans .gitignore).
# Ces variables doivent aussi être ajoutées dans Vercel : Project → Settings → Environment Variables
# ════════════════════════════════════════════════════════════════════════

# ─── Supabase ───────────────────────────────────────────────────────────
# Projet : sporthub (region West EU Paris eu-west-3)
# Dashboard : https://supabase.com/dashboard/project/qwfvcrisfmnrfzsrnjwn

NEXT_PUBLIC_SUPABASE_URL=https://qwfvcrisfmnrfzsrnjwn.supabase.co

# Publishable key (safe pour browser, équivalent anon key)
# Source : Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_vn80UINdOYv5cXOGFJ_V7g_vh8a69EC

# Secret key (SERVER-ONLY, jamais exposée au browser)
# Source : Settings → API Keys → Secret keys → cliquer l'œil pour révéler → Copy
# Format : sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=

# Database password (pour connexions Postgres directes, ex: import_v1.py)
# Source : celui que tu as généré à la création du projet
SUPABASE_DB_PASSWORD=
# Access token CLI Supabase (https://supabase.com/dashboard/account/tokens)
# Requis pour `supabase migration` / `supabase db push` (cf. scripts/db-push.sh)
SUPABASE_ACCESS_TOKEN=

# ─── V1 → V2 import ─────────────────────────────────────────────────────
# Path vers la SQLite V1 (pour scripts/import_v1.py)
V1_SQLITE_PATH=../SportHub/data-pipeline/data/sportpin.sqlite

# ─── Monitoring (à activer Phase 1 issue #7) ────────────────────────────
# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog (analytics produit)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ─── Map tiles (gratuit pour début) ─────────────────────────────────────
# MapTiler : free tier 100k req/mois — créer un compte sur maptiler.com
NEXT_PUBLIC_MAPTILER_KEY=

# ─── Admin ──────────────────────────────────────────────────────────────
# Email autorisé à accéder à /admin/* (vérifié via JWT custom claim ou check direct)
ADMIN_EMAIL=gautier.no@gmail.com
