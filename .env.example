# ──────────────────────────────────────────────────────────────────────────────
# Copier ce fichier vers .env.local et remplir les valeurs
# NE JAMAIS committer .env.local
# ──────────────────────────────────────────────────────────────────────────────

# Supabase (récupérer depuis supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # server-only, jamais exposé au client

# Sentry — monitoring erreurs (récupérer depuis sentry.io/settings/projects/sporthub/keys/)
# Mettre la MÊME valeur de DSN dans les deux variables (server + client).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# PostHog — analytics produit
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Google Search Console — vérification de propriété (#412).
# Search Console → Add property → méthode « HTML tag » → copier le token.
# VIDE → aucune balise <meta google-site-verification> n'est émise (no-op).
GOOGLE_SITE_VERIFICATION=

# MapTiler — tuiles vectorielles (free tier 100k/mois)
# Créer un compte sur maptiler.com → API Keys
NEXT_PUBLIC_MAPTILER_KEY=

# Vector tiles venues (#226) — URL publique du .pmtiles (Supabase Storage/CDN).
# Généré par scripts/generate_venue_tiles.py, uploadé par scripts/upload_venue_tiles.py.
# VIDE → la carte rend les pins via /api/venues (comportement actuel).
# RENSEIGNÉ → la carte rend les venues via pmtiles:// (coût O(1)).
# Ex: https://<projet>.supabase.co/storage/v1/object/public/tiles/venues.pmtiles
NEXT_PUBLIC_TILES_URL=

# Vercel cron — protège les routes app/api/cron/* (cf. issue #109).
# Générer un random base64 pour Vercel :
#   openssl rand -base64 32
# Vercel envoie automatiquement `Authorization: Bearer <CRON_SECRET>` sur les
# crons définis dans `vercel.json` quand cette variable est positionnée côté
# projet (Settings → Environment Variables).
CRON_SECRET=
